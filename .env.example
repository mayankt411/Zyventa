# Email delivery for the contact, product enquiry and newsletter forms.
# Copy to .env.local and fill in. Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives enquiries
ENQUIRY_TO=contact@zyventa.com
# Sender address on a domain verified in Resend
ENQUIRY_FROM=Zyventa Website <website@zyventa.com>
